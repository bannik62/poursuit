# ── App ──
NODE_ENV=development
PORT=3000

# ── Auth admin ──
JWT_SECRET=change-me-generate-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── URLs ──
# PC seul : http://localhost:8083
# Telephone (dev WSL) : utilise ngrok → ./scripts/ngrok-dev.sh
PUBLIC_URL=http://localhost:8083
FRONTEND_URL=http://localhost:8083
TRUST_PROXY_HOPS=2   # Apache + nginx en frontal

# ── ngrok (dev téléphone) ──
# Token : https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ── Jeu ──
MIN_PLAYERS=2
MAX_PLAYERS=4

# ── Sécurité ──
# Limites de débit
RATE_LIMIT_LOGIN_WINDOW_MS=600000     # 10 min
RATE_LIMIT_LOGIN_MAX=10               # 10 tentatives / 10 min / IP
RATE_LIMIT_PLAYER_WINDOW_MS=300000    # 5 min
RATE_LIMIT_PLAYER_MAX=60              # 60 req / 5 min / IP

# Sessions en mémoire
SESSIONS_MAX=20
SESSIONS_TTL_MINUTES=120
FINISHED_SESSIONS_TTL_MINUTES=60
SESSIONS_SWEEP_INTERVAL_MS=60000
